{
  "$schema": "https://opencode.ai/config.json",

  "model": "minieye/deepseek-v4-flash",
  "username": "mini",

  "lsp": true,

  "agent": {
    "explore": { "disable": true },
    "general": { "disable": true }
  },

  "command": {},

  "compaction": {
    "auto": false,
    "prune": false,
    "tail_turns": 80
  },

  "mode": {},

  "permission": {
    "*": "allow"
  },

  "plugin": [
    "@cortexkit/opencode-magic-context@latest",
    "oh-my-opencode-slim@latest"
  ],

  "provider": {
    // Minieye OpenAI (公司 OpenAI 接口 = codex key)
    "minieye": {
      "name": "Minieye",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "sk-fa85026177186ea1504f219cf0bf46f9bc92755ebd4697051cd1b92270013427",
        "baseURL": "https://sub2api.minieye.tech/v1",
        "includeUsage": true
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "cost":   { "input": 0.44, "output": 1.32 },
          "limit":  { "context": 1000000, "output": 384000 }
        },
        "deepseek-v4-flash-vision-exp": {
          "name": "deepseek-v4-flash-vision-exp",
          "cost":   { "input": 0.44, "output": 1.32 },
          "limit":  { "context": 1000000, "output": 384000 }
        },
        "glm-5.3-flash": {
          "name": "glm-5.3-flash",
          "cost":   { "input": 0.15, "output": 0.50 },
          "limit":  { "context": 1000000, "output": 128000 }
        },
        "gpt-5.4": {
          "name": "gpt-5.4",
          "cost":   { "input": 0.50, "output": 3.00 },
          "limit":  { "context":  1000000,   "output": 128000 }
        },
        "gpt-5.5": {
          "name": "gpt-5.5",
          "cost":   { "input": 1.25, "output": 7.50 },
          "limit":  { "context":  1050000,   "output": 128000 }
        },
        "gpt-5.6": {
          "name": "gpt-5.6",
          "cost":   { "input": 1.00, "output": 5.00 },
          "limit":  { "context":  1050000,   "output": 128000 }
        },
        "gpt-5.6-luna": {
          "name": "gpt-5.6-luna",
          "cost":   { "input": 0.05, "output": 0.30 },
          "limit":  { "context":  1050000,   "output": 128000 }
        },
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol",
          "cost":   { "input": 1.00, "output": 5.00 },
          "limit":  { "context":  1050000,   "output": 128000 }
        },
        "gpt-5.6-terra": {
          "name": "gpt-5.6-terra",
          "cost":   { "input": 0.50, "output": 3.00 },
          "limit":  { "context":  1050000,   "output": 128000 }
        },
        "gpt-image-2": {
          "name": "gpt-image-2",
          "cost":   { "input": 2.00, "output": 7.50 }
        },
        "qwen3.8-flash": {
          "name": "qwen3.8-flash",
          "cost":   { "input": 0.15, "output": 0.47 },
          "limit":  { "context": 1000000, "output": 128000 }
        }
      }
    },

    // Minieye Claude 计划 key（公司 Claude 接口，仅配可用 flash 系模型）
    "minieye-claude": {
      "name": "Minieye-Claude",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "sk-6590439b93c299437c01c0c246c82a17d896d06964974cb48aea5a70f22ba636",
        "baseURL": "https://sub2api.minieye.tech/v1",
        "includeUsage": true
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "cost":   { "input": 0.44, "output": 1.32 },
          "limit":  { "context": 1000000, "output": 384000 }
        },
        "deepseek-v4-flash-vision-exp": {
          "name": "deepseek-v4-flash-vision-exp",
          "cost":   { "input": 0.44, "output": 1.32 },
          "limit":  { "context": 1000000, "output": 384000 }
        },
        "glm-5.3-flash": {
          "name": "glm-5.3-flash",
          "cost":   { "input": 0.15, "output": 0.50 },
          "limit":  { "context": 1000000, "output": 128000 }
        },
        "qwen3.8-flash": {
          "name": "qwen3.8-flash",
          "cost":   { "input": 0.15, "output": 0.47 },
          "limit":  { "context": 1000000, "output": 128000 }
        }
      }
    }
  }
}
