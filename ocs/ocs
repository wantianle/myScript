#!/usr/bin/env bash
# ocs - OpenCode Session Manager
# 跨目录管理 opencode 的所有历史会话

set -eo pipefail

DB="$HOME/.local/share/opencode/opencode.db"
LIMIT=50

# ── 内部函数 ──────────────────────────────────────

_db() { sqlite3 "$DB" "$@"; }

_reltime() {
  local ts="$1"
  local now="$2"
  local diff="$(( now - ts ))"
  if   (( diff < 60 ));    then echo "${diff}s"
  elif (( diff < 3600 ));  then echo "$(( diff / 60 ))m"
  elif (( diff < 86400 )); then echo "$(( diff / 3600 ))h"
  else                           echo "$(( diff / 86400 ))d"
  fi
}

_shortdir() { echo "$1" | sed "s|^$HOME|~|"; }

_list() {
  local filter="$1" where="" w now
  [[ -n "$filter" ]] && where="WHERE title LIKE '%' || '$filter' || '%' OR directory LIKE '%' || '$filter' || '%'"

  local sql="SELECT id||'|'||title||'|'||directory||'|'||time_updated FROM session $where ORDER BY time_updated DESC LIMIT $LIMIT;"

  w=$(tput cols 2>/dev/null || echo 100)
  now=$(date +%s)

  # 根据宽度选布局
  local idw tw dw
  if   (( w >= 100 )); then idw=8  tw=40 dw=30
  elif (( w >= 80  )); then idw=8  tw=28 dw=24
  else                     idw=8  tw=$(( w - 20 )) dw=0; fi

  # 先把数据读成临时文件
  local tmp
  tmp=$(mktemp)
  local count=0
  while IFS='|' read -r id title dir ts_ms; do
    [[ -z "$id" ]] && continue
    local suffix=${id: -8}
    local age; age=$(_reltime "$(( ts_ms / 1000 ))" "$now")
    printf "%s\t%s\t%s\t%s\n" "$suffix" "$title" "$(_shortdir "$dir")" "$age" >> "$tmp"
    (( ++count ))
  done < <(_db "$sql")

  if [[ $count -eq 0 ]]; then
    echo "（没有会话记录）"
    rm -f "$tmp"
    return
  fi

  # 用 Python 做 CJK 感知的格式化（一次性处理所有行）
  python3 -c "
import sys
data = [line.rstrip('\n').split('\t', 3) for line in open('$tmp')]

def dw(s):
    return sum(2 if ord(c) > 127 else 1 for c in s)

def pad(s, w):
    d = dw(s)
    return s + ' ' * max(0, w - d)

def trunc(s, w):
    if w <= 2: return s[:w]
    if dw(s) <= w: return s
    r = ''
    used = 0
    for c in s:
        cw = 2 if ord(c) > 127 else 1
        if used + cw > w - 2: break
        r += c
        used += cw
    return r + '..'

idw, tw, dw_ = $idw, $tw, $dw

# 表头
if dw_ > 0:
    if '$filter':
        print(f'\033[2m* {pad(\"SEARCH: $filter\", tw + dw_ + idw)}\033[0m')
    print(f'\033[2m{pad(\"ID\",idw)}  {pad(\"TITLE\",tw)}  {pad(\"DIR\",dw_)}  AGE\033[0m')
else:
    if '$filter':
        print(f'\033[2m* {pad(\"SEARCH: $filter\", tw + idw)}\033[0m')
    print(f'\033[2m{pad(\"ID\",idw)}  {pad(\"TITLE\",tw)}  AGE\033[0m')

for row in data:
    sid, title, d, age = row
    if dw_ > 0:
        print(f'{pad(sid,idw)}  {pad(trunc(title,tw),tw)}  {pad(trunc(d,dw_),dw_)}  {age}')
    else:
        print(f'{pad(sid,idw)}  {pad(trunc(title,tw),tw)}  {age}')
"

  rm -f "$tmp"
  if [[ -n "$filter" ]]; then echo "→ 找到 $count 条，用 ocs r <关键词> 恢复"; fi
}

# 根据关键词/ID后缀/完整ID 解析为 session ID
_resolve() {
  local target="$1" sid
  if [[ "${target:0:4}" == "ses_" ]]; then
    sid="$target"
  elif [[ ${#target} -le 8 ]]; then
    # 短输入：先按 ID 后缀匹配
    sid=$(_db "SELECT id FROM session WHERE id LIKE '%$target' LIMIT 1;")
    # 无匹配则回退到标题搜索
    [[ -z "$sid" ]] && sid=$(_db "SELECT id FROM session WHERE title LIKE '%' || '$target' || '%' ORDER BY time_updated DESC LIMIT 1;")
  else
    sid=$(_db "SELECT id FROM session WHERE title LIKE '%' || '$target' || '%' ORDER BY time_updated DESC LIMIT 1;")
  fi
  echo "$sid"
}

_resume() {
  local sid
  sid=$(_resolve "$1")
  if [[ -z "$sid" ]]; then
    echo "未找到匹配 '$1' 的会话"
    return 1
  fi

  local dir title
  dir=$(_db "SELECT directory FROM session WHERE id='$sid';")
  title=$(_db "SELECT title FROM session WHERE id='$sid';")

  echo "会话: $title"
  echo "目录: $(_shortdir "$dir")"
  echo ""
  cd "$dir" 2>/dev/null || { echo "目录不存在，在当前目录恢复"; }
  opencode --session "$sid"
}

_delete() {
  local sid
  sid=$(_resolve "$1")
  if [[ -z "$sid" ]]; then
    echo "未找到匹配 '$1' 的会话"
    return 1
  fi

  local title
  title=$(_db "SELECT title FROM session WHERE id='$sid';")

  echo "即将删除会话: $title"
  echo -n "确认删除？(y/N) "
  read -r confirm
  if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
    echo "已取消"
    return
  fi

  _db "DELETE FROM session WHERE id='$sid';"
  echo "已删除: $title"
}

_rename() {
  local sid
  sid=$(_resolve "$1")
  if [[ -z "$sid" ]]; then
    echo "未找到匹配 '$1' 的会话"
    return 1
  fi

  local old_title new_title="$2"
  old_title=$(_db "SELECT title FROM session WHERE id='$sid';")

  if [[ -z "$new_title" ]]; then
    echo "用法: ocs rename <id|关键词> <新标题>"
    return 1
  fi

  _db "UPDATE session SET title='$new_title' WHERE id='$sid';"
  echo "已重命名: $old_title → $new_title"
}

_usage() {
  cat <<'EOF'
ocs — OpenCode Session Manager

用法:
  ocs                   列出最近会话（带目录、时间）
  ocs <关键词>           按标题/目录搜索
  ocs r <id|词>          恢复会话（自动切换到对应目录）
  ocs d <id|词>          删除会话（确认后删除）
  ocs rename <id|词> <名> 重命名会话

示例:
  ocs                    # 列出所有
  ocs coredump           # 筛选
  ocs r coredump         # 恢复最近一条匹配
  ocs d oJnNVI           # 删除指定会话
  ocs rename oJnNVI 新的名字  # 重命名
EOF
}

# ── 主入口 ────────────────────────────────────────

if [[ ! -f "$DB" ]]; then
  echo "错误: opencode 数据库未找到 ($DB)"
  exit 1
fi

case "${1:-}" in
  ""|list|ls)
    _list "${2:-}"
    ;;
  -h|--help)
    _usage
    ;;
  resume|r)
    [[ -z "${2:-}" ]] && { echo "用法: ocs resume <id|关键词>"; exit 1; }
    _resume "$2"
    ;;
  delete|d|rm)
    [[ -z "${2:-}" ]] && { echo "用法: ocs delete <id|关键词>"; exit 1; }
    _delete "$2"
    ;;
  rename|mv)
    [[ -z "${2:-}" ]] && { echo "用法: ocs rename <id|关键词> <新标题>"; exit 1; }
    _rename "$2" "${3:-}"
    ;;
  *)
    _count=$(_db "SELECT COUNT(*) FROM session WHERE title LIKE '%' || '$1' || '%' OR directory LIKE '%' || '$1' || '%';")
    if [[ "$_count" -eq 1 ]]; then
      _sid=$(_db "SELECT id FROM session WHERE title LIKE '%' || '$1' || '%' OR directory LIKE '%' || '$1' || '%' LIMIT 1;")
      echo "→ 直接恢复: $_sid"
      _resume "$_sid"
    else
      _list "$1"
    fi
    ;;
esac
