#!/usr/bin/env bash
# ocs - OpenCode Session Manager
# 跨目录管理 opencode 的所有历史会话

set -eo pipefail

DB="$HOME/.local/share/opencode/opencode.db"
LIMIT=50
VERSION="1.0.0"

# ── 内部函数 ──────────────────────────────────────

_db() { sqlite3 "$DB" "$@"; }

_reltime() {
  local ts="$1"
  local now="$2"
  local diff="$(( now - ts ))"
  if   (( diff < 60 ));    then echo "${diff}s"
  elif (( diff < 3600 ));  then echo "$(( diff / 60 ))m"
  elif (( diff < 86400 )); then echo "$(( diff / 3600 ))h"
  else                           echo "$(( diff / 86400 ))d"
  fi
}

_shortdir() { echo "$1" | sed "s|^$HOME|~|"; }

# 转义 SQL LIKE 通配符 % _
_escape_like() {
  local s="$1"
  s="${s//%/\\%}"
  s="${s//_/\\_}"
  echo "$s"
}

_list() {
  local filter="$1" mode="${2:-search}" kw where="WHERE parent_id IS NULL AND id LIKE 'ses_%'" w now
  kw=$(_escape_like "$filter")
  if [[ -n "$filter" ]]; then
    if [[ "$mode" == "id" ]]; then
      where="$where AND id LIKE '%$kw%'"
    else
      where="$where AND (title LIKE '%' || '$kw' || '%' OR directory LIKE '%' || '$kw' || '%')"
    fi
  fi

  local sql="SELECT id||'|'||title||'|'||directory||'|'||time_updated FROM session $where ORDER BY time_updated DESC LIMIT $LIMIT;"

  w=$(tput cols 2>/dev/null || echo 100)
  now=$(date +%s)

  # 根据宽度选布局
  local idw tw dw
  if   (( w >= 100 )); then idw=8  tw=40 dw=30
  elif (( w >= 80  )); then idw=8  tw=28 dw=24
  else                     idw=8  tw=$(( w - 20 )) dw=0; fi

  # 先把数据读成临时文件
  local tmp
  tmp=$(mktemp)
  local count=0
  while IFS='|' read -r id title dir ts_ms; do
    [[ -z "$id" ]] && continue
    local suffix=${id: -8}
    local age; age=$(_reltime "$(( ts_ms / 1000 ))" "$now")
    printf "%s\t%s\t%s\t%s\n" "$suffix" "$title" "$(_shortdir "$dir")" "$age" >> "$tmp"
    (( ++count ))
  done < <(_db "$sql")

  if [[ $count -eq 0 ]]; then
    echo "（没有会话记录）"
    rm -f "$tmp"
    return
  fi

  # 用 Python 做 CJK 感知的格式化（一次性处理所有行）
  python3 -c "
import sys
data = [line.rstrip('\n').split('\t', 3) for line in open('$tmp')]

def dw(s):
    return sum(2 if ord(c) > 127 else 1 for c in s)

def pad(s, w):
    d = dw(s)
    return s + ' ' * max(0, w - d)

def trunc(s, w):
    if w <= 2: return s[:w]
    if dw(s) <= w: return s
    r = ''
    used = 0
    for c in s:
        cw = 2 if ord(c) > 127 else 1
        if used + cw > w - 2: break
        r += c
        used += cw
    return r + '..'

idw, tw, dw_ = $idw, $tw, $dw

# 表头
if dw_ > 0:
    if '$filter':
        print(f'\033[2m* {pad(\"SEARCH: $filter\", tw + dw_ + idw)}\033[0m')
    print(f'\033[2m{pad(\"ID\",idw)}  {pad(\"TITLE\",tw)}  {pad(\"DIR\",dw_)}  AGE\033[0m')
else:
    if '$filter':
        print(f'\033[2m* {pad(\"SEARCH: $filter\", tw + idw)}\033[0m')
    print(f'\033[2m{pad(\"ID\",idw)}  {pad(\"TITLE\",tw)}  AGE\033[0m')

for row in data:
    sid, title, d, age = row
    if dw_ > 0:
        print(f'{pad(sid,idw)}  {pad(trunc(title,tw),tw)}  {pad(trunc(d,dw_),dw_)}  {age}')
    else:
        print(f'{pad(sid,idw)}  {pad(trunc(title,tw),tw)}  {age}')
"

  rm -f "$tmp"
}

# 根据关键词/ID后缀/完整ID 解析为 session ID
_resolve() {
  local target="$1" sid kw
  kw=$(_escape_like "$target")
  if [[ "${target:0:4}" == "ses_" ]]; then
    sid=$(_db "SELECT id FROM session WHERE parent_id IS NULL AND id LIKE 'ses_%' AND id='$target' LIMIT 1;")
    [[ -z "$sid" ]] && sid=$(_db "SELECT id FROM session WHERE parent_id IS NULL AND id LIKE 'ses_%' AND id LIKE '%$kw%' LIMIT 1;")
  else
    # 任意长度输入：先按 ID 片段匹配，支持 4 位、8 位、完整 ID 片段等
    sid=$(_db "SELECT id FROM session WHERE parent_id IS NULL AND id LIKE 'ses_%' AND id LIKE '%$kw%' LIMIT 1;")
    [[ -z "$sid" ]] && sid=$(_db "SELECT id FROM session WHERE parent_id IS NULL AND id LIKE 'ses_%' AND title LIKE '%' || '$kw' || '%' ORDER BY time_updated DESC LIMIT 1;")
  fi
  echo "$sid"
}

# 统计匹配数（与 _resolve 相同的匹配范围）
_match_count_id() {
  local target="$1" kw
  kw=$(_escape_like "$target")
  if [[ "${target:0:4}" == "ses_" ]]; then
    # 精确匹配优先，避免 id 片段误判为多条
    local exact_count
    exact_count=$(_db "SELECT COUNT(*) FROM session WHERE parent_id IS NULL AND id LIKE 'ses_%' AND id='$target';")
    if [[ "$exact_count" -gt 0 ]]; then
      echo "1"
    else
      _db "SELECT COUNT(*) FROM session WHERE parent_id IS NULL AND id LIKE 'ses_%' AND id LIKE '%$kw%';"
    fi
  else
    _db "SELECT COUNT(*) FROM session WHERE parent_id IS NULL AND id LIKE 'ses_%' AND id LIKE '%$kw%';"
  fi
}

# 标题+目录关键词搜索计数
_match_count_search() {
  local target="$1" kw
  kw=$(_escape_like "$target")
  _db "SELECT COUNT(*) FROM session WHERE parent_id IS NULL AND id LIKE 'ses_%' AND (title LIKE '%' || '$kw' || '%' OR directory LIKE '%' || '$kw' || '%');"
}

_resume() {
  local count sid
  count=$(_match_count_id "$1")

  if [[ "$count" -eq 0 ]]; then
    _list ""
    echo "→ 没有匹配 ID '$1' 的会话，已显示全部记录"
    return 1
  fi

  if [[ "$count" -gt 1 ]]; then
    _list "$1" "id"
    echo "→ 找到 $count 条，用 ocs <ID> 选择恢复"
    return 1
  fi

  # count == 1: 唯一匹配，直接恢复
  sid=$(_resolve "$1")
  local dir title
  dir=$(_db "SELECT directory FROM session WHERE id='$sid';")
  title=$(_db "SELECT title FROM session WHERE id='$sid';")

  echo "会话: $title"
  echo "目录: $(_shortdir "$dir")"
  echo ""
  cd "$dir" 2>/dev/null || { echo "目录不存在，在当前目录恢复"; }
  opencode --session "$sid"
}

_delete() {
  local count sid
  count=$(_match_count_id "$1")

  if [[ "$count" -eq 0 ]]; then
    echo "未找到匹配 ID '$1' 的会话"
    return 1
  fi

  if [[ "$count" -gt 1 ]]; then
    _list "$1" "id"
    echo "→ 找到 $count 条，用 ocs d <ID> 指定要删除的会话"
    return 1
  fi

  # count == 1: 唯一匹配
  sid=$(_resolve "$1")
  local title child_count
  title=$(_db "SELECT title FROM session WHERE id='$sid';")
  child_count=$(_db "SELECT COUNT(*) FROM session WHERE parent_id='$sid';")

  echo "即将删除会话: $title"
  [[ "$child_count" -gt 0 ]] && echo "  （含 $child_count 个子会话，将一并删除）"
  echo -n "确认删除？(y/N) "
  read -r confirm
  if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
    echo "已取消"
    return
  fi

  [[ "$child_count" -gt 0 ]] && _db "DELETE FROM session WHERE parent_id='$sid';"
  _db "DELETE FROM session WHERE id='$sid';"
  echo "已删除: $title"
  [[ "$child_count" -gt 0 ]] && echo "  （已级联删除 $child_count 个子会话）"
}

_rename() {
  local count sid
  count=$(_match_count_id "$1")

  if [[ "$count" -eq 0 ]]; then
    echo "未找到匹配 ID '$1' 的会话"
    return 1
  fi

  if [[ "$count" -gt 1 ]]; then
    _list "$1" "id"
    echo "→ 找到 $count 条，用 ocs r <ID> <新标题> 指定要重命名的会话"
    return 1
  fi

  # count == 1: 唯一匹配
  sid=$(_resolve "$1")
  local old_title new_title="$2"
  old_title=$(_db "SELECT title FROM session WHERE id='$sid';")

  if [[ -z "$new_title" ]]; then
    echo "用法: ocs rename <id|关键词> <新标题>"
    return 1
  fi

  _db "UPDATE session SET title='$new_title' WHERE id='$sid';"
  echo "已重命名: $old_title → $new_title"
}

_info() {
  local count sid
  count=$(_match_count_id "$1")

  if [[ "$count" -eq 0 ]]; then
    echo "未找到匹配 ID '$1' 的会话"
    return 1
  fi

  if [[ "$count" -gt 1 ]]; then
    _list "$1" "id"
    echo "→ 找到 $count 条，用 ocs i <ID> 查看详情"
    return 1
  fi

  # count == 1: 唯一匹配
  sid=$(_resolve "$1")
  local info
  info=$(_db "SELECT title || '|' || directory || '|' || datetime(time_created/1000, 'unixepoch', 'localtime') || '|' || datetime(time_updated/1000, 'unixepoch', 'localtime') || '|' || COALESCE(parent_id, '') || '|' || (SELECT COUNT(*) FROM session WHERE parent_id=s.id) FROM session s WHERE id='$sid';")
  IFS='|' read -r title dir created updated parent_id child_count <<< "$info"

  echo "ID:         $sid"
  echo "标题:       $title"
  echo "目录:       $(_shortdir "$dir")"
  echo "创建时间:   $created"
  echo "更新时间:   $updated"
  [[ -n "$parent_id" ]] && echo "父会话:     $parent_id" || echo "父会话:     （顶层）"
  [[ "$child_count" -gt 0 ]] && echo "子会话:     $child_count 个" || echo "子会话:     0"
}

_search() {
  local count sid
  count=$(_match_count_search "$1")

  if [[ "$count" -eq 0 ]]; then
    _list ""
    echo "→ 没有匹配 '$1' 的关键词，已显示全部记录"
    return 1
  fi

  if [[ "$count" -eq 1 ]]; then
    sid=$(_resolve "$1")
    local dir title
    dir=$(_db "SELECT directory FROM session WHERE id='$sid';")
    title=$(_db "SELECT title FROM session WHERE id='$sid';")
    echo "会话: $title"
    echo "目录: $(_shortdir "$dir")"
    echo ""
    cd "$dir" 2>/dev/null || { echo "目录不存在，在当前目录恢复"; }
    opencode --session "$sid"
    return
  fi

  _list "$1"
  echo "→ 找到 $count 条，用 ocs s <更具体的关键词> 或 ID 选择恢复"
}

_version() {
  echo "ocs — OpenCode Session Manager  v$VERSION"
  echo "路径: $0"
}

_usage() {
  cat <<'EOF'
ocs — OpenCode Session Manager

用法:
  ocs                   列出最近会话（带目录、时间）
  ocs <ID片段>           按 ID 恢复：唯一→恢复，多条→列表，无→全部
  ocs s <关键词>         按标题+目录搜索唯一→恢复，多条→列表，无→全部
  ocs d <ID片段>         删除会话（确认后删除）
  ocs i <ID片段>         查看会话详细信息
  ocs r <ID片段> <名>    重命名会话
  ocs rename <ID片段> <名> 同上

示例:
  ocs                    # 列出所有
  ocs iyeTCx6Y           # 按 ID 恢复（支持片段匹配）
  ocs s ssh             # 搜索含 ssh 的会话，唯一匹配直接恢复
  ocs d oJnNVI           # 删除指定会话
  ocs i oJnNVI           # 查看会话详情
  ocs r oJnNVI 新的名字  # 重命名
EOF
}

# ── 主入口 ────────────────────────────────────────

if [[ ! -f "$DB" ]]; then
  echo "错误: opencode 数据库未找到 ($DB)"
  exit 1
fi

case "${1:-}" in
  "")
    _list "${2:-}"
    ;;
  -h|--help)
    _usage
    ;;
  -v|--version)
    _version
    ;;
  s|search)
    [[ -z "${2:-}" ]] && { echo "用法: ocs s <关键词>"; exit 1; }
    _search "$2"
    ;;
  delete|d|rm)
    [[ -z "${2:-}" ]] && { echo "用法: ocs delete <id|关键词>"; exit 1; }
    _delete "$2"
    ;;
  info|i)
    [[ -z "${2:-}" ]] && { echo "用法: ocs info <id|关键词>"; exit 1; }
    _info "$2"
    ;;
  rename|mv|r)
    [[ -z "${2:-}" ]] && { echo "用法: ocs rename <id|关键词> <新标题>"; exit 1; }
    _rename "$2" "${3:-}"
    ;;
  *)
    _resume "$1"
    ;;
esac
