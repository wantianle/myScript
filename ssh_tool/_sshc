#compdef sshc

local -a vehicles
local message_file
local output

_sshc_remote_paths() {
  return 0
}

if [[ "$words[2]" == "config" || "$words[2]" == "cfg" ]]; then
  _arguments \
    '-u[set prod XiaoZhu username]:username:' \
    '--username[set prod XiaoZhu username]:username:' \
    '-p[set prod XiaoZhu password]:password:' \
    '--password[set prod XiaoZhu password]:password:' \
    '--prod-username[set prod XiaoZhu username]:username:' \
    '--prod-password[set prod XiaoZhu password]:password:' \
    '--test-username[set test XiaoZhu username]:username:' \
    '--test-password[set test XiaoZhu password]:password:' \
    '-k[set private key file]:keyfile:_files' \
    '--keyfile[set private key file]:keyfile:_files'
  return
fi

if [[ "$words[3]" == "push" ]]; then
  if [[ CURRENT -eq 4 ]]; then
    _files
  elif [[ CURRENT -eq 5 ]]; then
    _sshc_remote_paths
  fi
  return
fi

if [[ "$words[3]" == "pull" ]]; then
  if [[ CURRENT -eq 4 ]]; then
    _sshc_remote_paths
  elif [[ CURRENT -eq 5 ]]; then
    _files
  fi
  return
fi

if [[ CURRENT -eq 3 && "$words[2]" != "-v" && "$words[2]" != "--versions" ]]; then
  compadd push pull add a -v --versions
  return
fi

if [[ "$words[2]" == ./* || "$words[2]" == ../* || "$words[2]" == /* || "$words[2]" == \~/* ]]; then
  _files
  return
fi

if [[ CURRENT -eq 2 || ( ( "$words[2]" == "-v" || "$words[2]" == "--versions" ) && CURRENT -eq 3 ) ]]; then
  message_file="$(mktemp)"
  output="$(_call_program sshc-vehicles sshc --complete-vehicles "$PREFIX" 2>"$message_file")"
  if [[ -n "$output" ]]; then
    vehicles=("${(@f)output}")
  fi
  if (( ${#vehicles[@]} > 0 )); then
    rm -f "$message_file"
    compstate[insert]=menu
    compadd config cfg push pull add a -v --versions
    compadd -Q -U -a vehicles
  else
    local message
    message="$(<"$message_file")"
    rm -f "$message_file"
    if [[ -n "$message" ]]; then
      _message -r "$message"
    fi
    compadd config cfg push pull add a -v --versions
  fi
  return
fi

_arguments \
  '-v[show C4 status, versions, and existing port mappings]' \
  '--versions[show C4 status, versions, and existing port mappings]'
